# Copy to .env  (never commit .env)
INTEL_MODE=mock            # mock = offline fixtures; live = Member 3's OSV/EPSS/KEV agent
GEMINI_API_KEY=            # optional; without it the LLM steps fall back to deterministic text
LLM_ENABLED=true
LOG_LEVEL=INFO
API_KEY=                   # optional; if set, clients must send header X-API-Key
MAX_UPLOAD_MB=50
